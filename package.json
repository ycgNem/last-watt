{
  "name": "last-watt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A pixel-art tower defense where energy is a live flow.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "continue": "node e2e/continue.mjs",
    "smoke": "node e2e/smoke.mjs",
    "shots": "node e2e/shots.mjs",
    "screens": "node e2e/screens.mjs",
    "art": "python3 pixel-art/build_all.py"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "1.48.2",
    "typescript": "7.0.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
